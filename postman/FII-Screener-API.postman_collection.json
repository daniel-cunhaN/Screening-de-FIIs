    },
    {
      "name": "❌ Buscar FII Inexistente (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/fiis/XXXX99",
          "host": ["{{baseUrl}}"],
          "path": ["api", "fiis", "XXXX99"]
        },
        "description": "Testa a busca de um ticker inexistente. Deve retornar HTTP 404.\n\n**Resultado esperado:** Status 404 (Not Found) sem body."
      },
      "response": [
        {
          "name": "404 — FII não encontrado",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/fiis/XXXX99",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fiis", "XXXX99"]
            }
          },
          "status": "Not Found",
          "code": 404,
          "_postman_previewlanguage": "json",
          "header": [],
          "body": ""
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 for invalid ticker', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Response body is empty', function () {",
              "    pm.expect(pm.response.text()).to.be.empty;",
              "});"
