            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "🔄 Trigger de Atualização Manual",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{baseUrl}}/api/fiis/update",
          "host": ["{{baseUrl}}"],
          "path": ["api", "fiis", "update"]
        },
        "description": "Dispara uma atualização manual dos dados de FIIs via StatusInvest API.\n\n**Atenção:** Este endpoint faz chamadas externas à API do StatusInvest e pode demorar alguns segundos.\n\n**Retorno de sucesso:** `{\"message\": \"FII data updated successfully from StatusInvest API.\"}`\n\n**Retorno de erro:** `{\"error\": \"Failed to update FII data: <mensagem>\"}`"
      },
      "response": [
        {
          "name": "200 — Atualização com sucesso",
          "originalRequest": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/fiis/update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fiis", "update"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"message\": \"FII data updated successfully from StatusInvest API.\"\n}"
        },
        {
          "name": "500 — Erro na atualização",
          "originalRequest": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/fiis/update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fiis", "update"]
            }
          },
          "status": "Internal Server Error",
          "code": 500,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"error\": \"Failed to update FII data: Connection refused\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or 500', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 500]);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test('Success message returned', function () {",
              "        pm.expect(pm.response.json().message).to.include('successfully');",
              "    });",
              "} else {",
              "    pm.test('Error message returned', function () {",
              "        pm.expect(pm.response.json()).to.have.property('error');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
