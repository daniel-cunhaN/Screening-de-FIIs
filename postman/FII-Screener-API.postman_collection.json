{
  "info": {
    "_postman_id": "fii-screener-api-v1",
    "name": "🏢 FII Screener API",
    "description": "Coleção completa para testar os endpoints da Plataforma de Screener e Análise de FIIs.\n\n## Setup\n1. Importe esta collection no Postman ou Insomnia\n2. Certifique-se de que a aplicação está rodando (`./run.sh`)\n3. A variável `baseUrl` já está configurada para `http://localhost:8080`\n\n## Endpoints Disponíveis\n- **GET /api/fiis** — Lista todos os FIIs cadastrados\n- **GET /api/fiis/{ticker}** — Busca um FII por ticker\n- **POST /api/fiis/update** — Trigger manual de atualização dos dados\n\n## Tickers Monitorados\nMXRF11, HGLG11, VISC11, BTLG11, KNIP11",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "ticker",
      "value": "MXRF11",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "📋 Listar Todos os FIIs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/fiis",
          "host": ["{{baseUrl}}"],
          "path": ["api", "fiis"]
        },
        "description": "Retorna a lista completa de todos os FIIs cadastrados no banco de dados.\n\n**Retorno esperado:** Array JSON com objetos Fii contendo: ticker, price, dividendYield, dividendYield1m, pvp, vacancy, segment, netWorth, equityValue, type, lastUpdate."
      },
      "response": [
        {
          "name": "200 — Lista de FIIs",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/fiis",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fiis"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "[\n  {\n    \"ticker\": \"MXRF11\",\n    \"price\": 10.45,\n    \"dividendYield\": 12.5,\n    \"dividendYield1m\": 1.04,\n    \"pvp\": 1.02,\n    \"vacancy\": 0.0,\n    \"segment\": \"Híbrido\",\n    \"netWorth\": 3500000000.0,\n    \"equityValue\": 10.25,\n    \"type\": \"Títulos e Val. Mob.\",\n    \"lastUpdate\": \"2026-06-15T18:00:00\"\n  },\n  {\n    \"ticker\": \"HGLG11\",\n    \"price\": 162.30,\n    \"dividendYield\": 8.2,\n    \"dividendYield1m\": 0.68,\n    \"pvp\": 1.15,\n    \"vacancy\": 0.0,\n    \"segment\": \"Logística\",\n    \"netWorth\": 8000000000.0,\n    \"equityValue\": 141.00,\n    \"type\": \"Tijolo\",\n    \"lastUpdate\": \"2026-06-15T18:00:00\"\n  }\n]"
        },
        {
          "name": "200 — Lista vazia (sem dados)",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/fiis",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fiis"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "[]"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test('Response time is acceptable', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "if (pm.response.json().length > 0) {",
              "    pm.test('Each FII has required fields', function () {",
              "        var fii = pm.response.json()[0];",
              "        pm.expect(fii).to.have.property('ticker');",
              "        pm.expect(fii).to.have.property('price');",
              "        pm.expect(fii).to.have.property('dividendYield');",
              "        pm.expect(fii).to.have.property('pvp');",
              "        pm.expect(fii).to.have.property('lastUpdate');",
              "    });",
              "",
              "    // Salva o primeiro ticker para uso nos próximos testes",
              "    pm.collectionVariables.set('ticker', pm.response.json()[0].ticker);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "🔍 Buscar FII por Ticker",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/fiis/{{ticker}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "fiis", "{{ticker}}"]
        },
        "description": "Busca um FII específico pelo seu ticker.\n\n**Parâmetro:** `ticker` — código do FII (ex: MXRF11, HGLG11)\n\n**Retorno:** Objeto Fii ou 404 se não encontrado."
      },
      "response": [
        {
          "name": "200 — FII encontrado",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/fiis/MXRF11",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fiis", "MXRF11"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": "{\n  \"ticker\": \"MXRF11\",\n  \"price\": 10.45,\n  \"dividendYield\": 12.5,\n  \"dividendYield1m\": 1.04,\n  \"pvp\": 1.02,\n  \"vacancy\": 0.0,\n  \"segment\": \"Híbrido\",\n  \"netWorth\": 3500000000.0,\n  \"equityValue\": 10.25,\n  \"type\": \"Títulos e Val. Mob.\",\n  \"lastUpdate\": \"2026-06-15T18:00:00\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has correct ticker', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.ticker).to.eql(pm.collectionVariables.get('ticker'));",
              "});",
              "",
              "pm.test('FII has all required fields', function () {",
              "    var fii = pm.response.json();",
              "    pm.expect(fii).to.have.property('ticker');",
              "    pm.expect(fii).to.have.property('price');",
              "    pm.expect(fii).to.have.property('dividendYield');",
              "    pm.expect(fii).to.have.property('pvp');",
              "    pm.expect(fii).to.have.property('lastUpdate');",
              "});",
              "",
              "pm.test('Price is a positive number', function () {",
              "    pm.expect(pm.response.json().price).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "🔍 Buscar FII — HGLG11",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/fiis/HGLG11",
